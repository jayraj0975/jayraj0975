{
  "name": "acquicode",
  "private": true,
  "version": "0.1.0",
  "description": "Evidence-graded technical diligence for AI-built software",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' run build && pnpm --filter @acquicode/web run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "fixture:meridian": "pnpm --filter @acquicode/engine exec tsx -e \"import('./src/demo/meridian.ts').then(m=>console.log(JSON.stringify(m.buildMeridian(process.argv[1]).commits,null,2)))\""
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
